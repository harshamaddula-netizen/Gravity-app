# TruthLens AI Environment Configuration

# Application settings
APP_NAME=TruthLens AI
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Demo & Uncertainty Layer thresholds
DEMO_MODE=true
MIN_EVIDENCE_SCORE=0.55
MIN_RELEVANT_SOURCES=1
TOP_K_EVIDENCE=5
MAX_CLAIM_LENGTH=1000

# File Paths
EVIDENCE_DATA_PATH=data/sample_evidence/evidence_corpus.json
DATABASE_PATH=truthlens.db

# LLM Provider Configuration
# Supported values: demo | openai | gemini | auto
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here


# ML Transformer Classifier (optional)
ENABLE_TRANSFORMER_CLASSIFIER=false
ML_MODEL_PATH=

# Frontend Environment Variable
VITE_API_BASE_URL=http://localhost:8000
